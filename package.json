{
  "name": "pebble",
  "version": "1.0.0",
  "description": "Headless Cloudflare Worker sync backend for Cairn and Obsidian",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "scripts": {
    "dev": "wrangler dev",
    "build": "tsc --noEmit && wrangler deploy --dry-run",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261115.1",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.69.0"
  }
}
